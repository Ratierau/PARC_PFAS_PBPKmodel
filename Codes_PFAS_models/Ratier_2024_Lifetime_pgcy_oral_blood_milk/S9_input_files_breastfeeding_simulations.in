  PC_15 = 0.63;
  PC_16 = 0.58;
  PC_17 = 0.58;
  PC_18 = 0.52;
  PC_22 = 1;
  
  PC_blood_over_air = 1E99;
  
  # other transfers
  Ka_stomach         = 0.00;
  Ka_gut             = 0.00; 
  Ke_renal_input     = 0; 
  F_gut2faeces_input = 0; 
  Ke_bile            = 0;

  # Variations of intake (=1 to model variations with age)
  Intake_var = 1;
