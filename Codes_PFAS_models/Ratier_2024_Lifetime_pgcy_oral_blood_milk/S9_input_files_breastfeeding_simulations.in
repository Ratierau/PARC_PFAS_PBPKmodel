  Frac_Intake_Toddler = 3.80;
  Frac_Intake_Children = 2.75;
  Frac_Intake_Ado = 1.41;
  DecreaseIntake_1 = 0.20;
  DecreaseIntake_2 = 0.04;
  
    # Simulations 
    #------------
   # exclusive BF
Simulation { # Subject no BF
# Birth year
BirthYear = 2007 ;
    # BodyWeigth Parameters
    BDW_Var = 0.900308438844513 ;
    BDW_Var2 = 0.860834986909385 ;
    BDW_Var3 = -1.05664919997588 ;
    BDW_foetus_Var = 1;
    WeightGainPregnancy_Var = 1;
    StopBreastmilk_total = 0;
    RateInj = NDoses(2, 0.451695,  0, 0, 6000000);
    C_milk_input = 0; #28days
    
# Initial amounts in the newborn
    Q_0 = 4.85008; 
    Q_1 = 0.05425;
    Q_2 = 0.43787;
    Q_3 = 0.56456;
    Q_4 = 0;
