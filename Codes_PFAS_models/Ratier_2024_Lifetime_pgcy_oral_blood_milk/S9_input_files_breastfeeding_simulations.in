    Q_19 = 0;
    Q_20 = 0;
    Q_art = 0.3309;
Q_ven = 0.99083;

        PrintStep(C_ven, C_milk_evol, BDW, Fmilk_tot, 0,3561120, 1440);
  } # end Subject 
  
