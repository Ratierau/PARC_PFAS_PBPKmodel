#--------------------------------------------------------------------------
# HELIX child - boys
#--------------------------------------------------------------------------
Integrate (Lsodes, 1E-6, 1E-6, 1);

OutputFile("fit_pfoa_ kinetic_boys_BF_profiles.out");
  # Parameters specific to PFOA
  # ---------------------------
  # intestinal absorption (%)
  Abs = 1;
  # Free fraction in blood
  Free = 0.02;
  # elimination (in years)
  HalfLife = 2.5; #3.0
  # Partition coefficient 
  PC_0  = 0.23;
  PC_1  = 0.58;
  PC_2  = 0.58;
  PC_3  = 0.08;
  PC_4  = 0.10;
  PC_5  = 0.58;
